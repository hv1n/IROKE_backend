# 서버 전용. 이 파일을 .env로 복사해서 채운다. Vercel에서는 프로젝트 Environment Variables에 같은 이름으로 등록한다.
PORT=8787

# 브라우저 호출을 허용할 출처 (쉼표 구분). 프론트 배포 주소와 로컬 Vite
CORS_ORIGINS=https://iroke.vercel.app,http://localhost:5173

# ── 디자이너 구하기 (v2) ──────────────────────────────────────
# memory = 로컬·테스트용. 서버를 다시 띄우면 초기화되고, 시연 계정 3명(db/seed.sql과 같음)이 들어 있다.
#          카카오 없이 POST /api/auth/dev { "kakaoId": "seed-customer-1" } 로 로그인할 수 있다 (production에서는 꺼짐).
# supabase = Postgres(DATABASE_URL) + Supabase Storage 비공개 버킷
DATA_MODE=memory

# memory 모드에서 서명 업로드·보기 URL에 쓰는 이 서버 주소 (기본 http://localhost:$PORT)
PUBLIC_BASE_URL=

# 로그인 토큰(JWT) 서명 키. 길고 무작위인 값 (예: openssl rand -base64 48). memory 모드 로컬 실행만 비워도 됨
JWT_SECRET=
# 로그인 유지 시간(초). 기본 7일
JWT_TTL_SEC=604800

# 카카오 로그인 (https://developers.kakao.com → 내 애플리케이션 → 앱 키 · 카카오 로그인 · 보안)
KAKAO_REST_API_KEY=
# 카카오 로그인 보안 > Client Secret을 '사용함'으로 켰을 때만
KAKAO_CLIENT_SECRET=

# Supabase (DATA_MODE=supabase일 때 필수)
# Project Settings > Database > Connection string > Transaction pooler (포트 6543)
DATABASE_URL=
# Project Settings > API > Project URL
SUPABASE_URL=
# Project Settings > API > service_role 키. 서버 전용, 절대 프론트에 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=
# 비공개 버킷 이름 (db/migrations/002_storage_bucket.sql과 같아야 함)
SUPABASE_BUCKET=iroke-private

# 배치(/api/internal/jobs/sweep) 보호. Vercel Cron이 Authorization: Bearer <CRON_SECRET>으로 보낸다. 비우면 배치 호출 불가
CRON_SECRET=

# ── 시안 만들기 (기존) ─────────────────────────────────────────
# mock = API 비용 없이 전체 플로우 확인 (분석은 고정 예시, 시안은 셀카를 그대로 돌려줌)
# gemini = 실제 분석·생성 (결제 등록된 GEMINI_API_KEY 필요)
AI_MODE=mock

# Google Gemini (https://aistudio.google.com/apikey) — 무료 등급 없음
GEMINI_API_KEY=
# 시안 생성 (2026-10 실측: 1K 1장 약 68원, 재시도도 별도 과금)
GEMINI_MODEL=gemini-nano-banana-2.1
# 1K 권장 (2K, 4K는 비용·지연 증가)
GEMINI_IMAGE_SIZE=1K
# 모발 분석·스타일 추천 (1회 약 1.6~2원, 5초)
GEMINI_ANALYZE_MODEL=gemini-3.5-flash-lite
# 분석 모델 과부하(429/5xx) 시 1회 재시도 후 넘어갈 대체 모델 (비우면 사용 안 함)
GEMINI_ANALYZE_FALLBACK_MODEL=gemini-3.8-flash
# 1이면 응답 구조를 서버 콘솔에 출력
GEMINI_DEBUG=0

# 시안 프롬프트 버전 (v1 | v2). 결과와 함께 기록된다.
PROMPT_VERSION=v1

# 사용자(브라우저)별 하루 시안 생성 횟수. 비우면 제한 없음 (정책 미정)
GENERATION_DAILY_LIMIT=
GENERATION_TIMEOUT_MS=60000
ANALYSIS_TIMEOUT_MS=30000

# 이벤트 로그(JSONL) 위치. 사진은 기록하지 않는다. git 제외.
# Vercel은 /tmp만 쓸 수 있으므로 배포 환경에서는 /tmp/logs로 둔다 (함수 인스턴스가 바뀌면 사라짐).
LOG_DIR=logs

# MockProvider 응답 지연
MOCK_DELAY_MIN_MS=800
MOCK_DELAY_MAX_MS=2500
